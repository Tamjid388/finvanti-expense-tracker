# ---------- Secrets / env (never commit) ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Databases (never commit) ----------
*.sqlite3
*.sqlite
*.db
*.sql.gz
*.dump

# ---------- Python (server/) ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version
pip-log.txt
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache/

# ---------- Django ----------
media/
staticfiles/
*.log
local_settings.py

# ---------- Node / client/ (future frontend) ----------
node_modules/
dist/
build/
.next/
out/
.nuxt/
.vite/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
bun.lockb

# ---------- IDE / editors ----------
.vscode/
.idea/
*.swp
*.swo
.cursor/
.windsurf/

# ---------- OS junk (Windows primary, but cover all) ----------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
*.lnk

# ---------- AI agent / tooling artifacts ----------
.claude/settings.local.json
*.session.json

# Host-local mirrors of the vendored gstack skill library.
# The canonical copy is tracked at .agents/skills/gstack/; these two are
# recreated per machine by the gstack setup script.
.claude/skills/
agent/
