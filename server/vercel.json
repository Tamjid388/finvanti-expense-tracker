{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.py" }]
}
